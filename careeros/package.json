{
  "name": "careeros",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "build": "turbo run build --filter=api --filter=web",
    "lint": "turbo run lint --filter=api --filter=web",
    "type-check": "turbo run type-check --filter=api --filter=web",
    "test": "turbo run test --filter=api --filter=web",
    "db:generate": "pnpm --filter api exec npm run db:generate",
    "db:migrate": "pnpm --filter api exec npm run db:migrate",
    "db:seed": "pnpm --filter api exec npm run db:seed"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "prettier": "^3.2.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
