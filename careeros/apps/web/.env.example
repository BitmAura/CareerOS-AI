# =============================================================================
# CareerOS web app — put secrets in apps/web/.env.local (Next.js loads THIS file)
# Monorepo root careeros/.env is NOT read by the Next app unless you copy keys here.
# =============================================================================

NEXT_PUBLIC_API_URL=/api
# Production: https://your-domain (must match the live host for sitemap/canonicals)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Google Search Console HTML tag verification
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- REQUIRED for local login sessions ---
JWT_SECRET=careeros-dev-secret-change-me

# --- REQUIRED for live job search + URL Fetch (you have this) ---
# https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# --- STRONGLY RECOMMENDED for accurate resume improve / tailor / packets ---
# Pick ONE path (OpenAI recommended for lower-cost gpt-4.1-mini):
# A) OpenAI-compatible
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# B) Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- OPTIONAL production data (without these → local .data/store.json) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- OPTIONAL cron digest on Vercel ---
# CRON_SECRET=

# --- OPTIONAL MarkItDown PDF/DOCX worker ---
# RESUME_PARSE_URL=http://127.0.0.1:8001

# =============================================================================
# Keys → accuracy map
# TINYFISH_API_KEY     = live Search + Fetch for public careers (digest + URL paste)
# GEMINI or OPENAI_*   = high-quality ATS rewrite / tailor (else heuristic templates)
# JWT_SECRET           = auth tokens stay valid across restarts
# SUPABASE_*           = multi-device / prod DB (else local JSON only)
# RESUME_PARSE_URL     = better PDF extract than unpdf alone
# =============================================================================
