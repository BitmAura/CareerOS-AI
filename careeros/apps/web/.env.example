# =============================================================================
# CareerOS web app — put secrets in apps/web/.env.local (Next.js loads THIS file)
# Monorepo root careeros/.env is NOT read by the Next app unless you copy keys here.
# =============================================================================

NEXT_PUBLIC_API_URL=/api
# Production: https://your-domain (must match the live host for sitemap/canonicals)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Google Search Console HTML tag verification
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- REQUIRED for local login sessions ---
JWT_SECRET=careeros-dev-secret-change-me

# --- REQUIRED for live job search + URL Fetch (you have this) ---
# https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# --- STRONGLY RECOMMENDED for accurate resume improve / tailor / packets ---
# Pick ONE path (OpenAI recommended for lower-cost gpt-4.1-mini):
# A) OpenAI-compatible
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# B) Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- REQUIRED for magic link + Google (optional) + durable hunt data ---
# App names, or Vercel Supabase integration names (mapped at build):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# Server-only. Needed for digest/queue writes that bypass RLS. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Magic link (default for network pilot — no Google Client ID needed):
# 1) Supabase → Authentication → Providers → Email → Enable
#    Confirm "Confirm email" / magic link settings as needed.
# 2) Supabase → Authentication → URL Configuration:
#    Site URL: https://your-app.vercel.app
#    Redirect URLs (required):
#      https://your-app.vercel.app/auth/callback
#      http://localhost:3000/auth/callback
# 3) Optional later: custom SMTP (Resend) so links do not land in spam.

# Google login (optional secondary):
# 1) Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
#    Authorized redirect URI (exact):
#    https://YOUR_PROJECT.supabase.co/auth/v1/callback
# 2) Supabase Dashboard → Authentication → Providers → Google → Enable
#    Paste Client ID + Client Secret from Google Cloud, Save.
# App uses: /auth/callback (no GOOGLE_* env vars in Next — secrets live in Supabase).

# --- OPTIONAL billing (production refuses mock upgrades without these) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# BILLING_ALLOW_MOCK=true   # only for intentional prod sandbox tests

# --- OPTIONAL cron digest on Vercel ---
# CRON_SECRET=

# --- OPTIONAL MarkItDown PDF/DOCX worker ---
# RESUME_PARSE_URL=http://127.0.0.1:8001

# =============================================================================
# Keys → accuracy map
# TINYFISH_API_KEY     = live Search + Fetch for public careers (digest + URL paste)
# GEMINI or OPENAI_*   = high-quality ATS rewrite / tailor (else heuristic templates)
# JWT_SECRET           = auth tokens stay valid across restarts
# SUPABASE_*           = multi-device / prod DB (else local JSON only)
# RESUME_PARSE_URL     = better PDF extract than unpdf alone
# =============================================================================
