{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/digest",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 13 * * *"
    }
  ]
}
